        "data": {
          "state": {
            "valve": {
              "type": "SwitchCommand",
              "required": true,
              "comment": "['close','open']"
            },
            "meter": {
              "type": "Integer",
              "required": true,
              "comment": "Meter reading"
            },
            "waterFlowing": {
              "type": "Boolean",
              "required": true
            }
          },
          "alarm": {
