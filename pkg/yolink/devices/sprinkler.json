{
  "name": "Sprinkler",
  "methods": [
    {
      "name": "getState",
      "description": "Get Current State",
      "request": {
        "method": "getState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "state": {
            "mode": {
              "type": "SprinklerMode",
              "required": true,
              "comment": "['auto','manual','off']"
            },
            "zoneSize": {
              "type": "Integer",
              "required": true,
              "comment": "Number of zones"
            },
            "delay": {
              "type": "Integer",
              "required": true,
              "comment": "Minutes to delay"
            },
            "watering": {
              "zone": {
                "type": "Integer",
                "required": false,
                "comment": "Current watering zone index"
              },
              "total": {
                "type": "Integer",
                "required": false,
                "comment": "Total watering time minutes"
              },
              "left": {
                "type": "Integer",
                "required": false,
                "comment": "Remaining watering time minutes"
              }
            }
          },
          "setting": {
            "maxWaterTime": {
              "type": "Integer",
              "required": true,
              "comment": "Max watering time"
            },
            "manualWater": "<Array<Integer>,Necessary> Zone times for manual mode"
          },
          "version": {
            "type": "String",
            "required": true
          },
          "tz": {
            "type": "Integer",
            "required": true
          }
        }
      }
    },
    {
      "name": "setState",
      "description": "Set Sprinkler's State",
      "request": {
        "method": "setState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "state": {
            "mode": {
              "type": "SprinklerMode",
              "required": false,
              "comment": "['auto','manual','off']"
            },
            "zoneSize": {
              "type": "Integer",
              "required": false
            },
            "delay": {
              "type": "Integer",
              "required": false
            }
          },
          "setting": {
            "manualWater": "<Array<Integer>,Optional>",
            "maxWaterTime": {
              "type": "Integer",
              "required": false
            }
          }
        }
      },
      "response": {
        "data": {
          "state": {
            "mode": {
              "type": "SprinklerMode",
              "required": true,
              "comment": "['auto','manual','off']"
            },
            "zoneSize": {
              "type": "Integer",
              "required": true,
              "comment": "Number of zones"
            },
            "delay": {
              "type": "Integer",
              "required": true,
              "comment": "Minutes to delay"
            },
            "watering": {
              "zone": {
                "type": "Integer",
                "required": false,
                "comment": "Current watering zone index"
              },
              "total": {
                "type": "Integer",
                "required": false,
                "comment": "Total watering time minutes"
              },
              "left": {
                "type": "Integer",
                "required": false,
                "comment": "Remaining watering time minutes"
              }
            }
          },
          "setting": {
            "maxWaterTime": {
              "type": "Integer",
              "required": true,
              "comment": "Max watering time"
            },
            "manualWater": "<Array<Integer>,Necessary> Zone times for manual mode"
          },
          "version": {
            "type": "String",
            "required": true
          },
          "tz": {
            "type": "Integer",
            "required": true
          }
        }
      }
    },
    {
      "name": "setManualWater",
      "description": "Start/stop manual watering",
      "request": {
        "method": "setManualWater",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "state": {
            "type": "SprinklerCommand",
            "required": true,
            "comment": "['start','stop']"
          }
        }
      },
      "response": {}
    },
    {
      "name": "getSchedules",
      "description": "Get Schedule List",
      "request": {
        "method": "getSchedules",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "sches": {
            "type": "Array",
            "required": true,
            "items": {
              "date": {
                "type": "String",
                "required": true,
                "comment": "Session start date M-d"
              },
              "weekmask": {
                "type": "Integer",
                "required": true,
                "comment": "Enabled weekdays mask"
              },
              "plans": {
                "type": "Array",
                "required": true,
                "items": {
                  "time": {
                    "type": "String",
                    "required": true,
                    "comment": "Start time h:m:s"
                  },
                  "zones": "<Array<Integer>,Necessary> Zone water times"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "setSchedules",
      "description": "Set Schedule",
      "request": {
        "method": "setSchedules",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "sches": {
            "type": "Array",
            "required": true,
            "items": {
              "date": {
                "type": "String",
                "required": true,
                "comment": "M-d"
              },
              "weekmask": {
                "type": "Integer",
                "required": true
              },
              "plans": {
                "type": "Array",
                "required": true,
                "items": {
                  "time": {
                    "type": "String",
                    "required": true,
                    "comment": "h:m:s"
                  },
                  "zones": "<Array<Integer>,Necessary>"
                }
              }
            }
          }
        }
      },
      "response": {
        "data": {
          "sches": {
            "type": "Array",
            "required": true,
            "items": {
              "date": {
                "type": "String",
                "required": true,
                "comment": "Session start date M-d"
              },
              "weekmask": {
                "type": "Integer",
                "required": true,
                "comment": "Enabled weekdays mask"
              },
              "plans": {
                "type": "Array",
                "required": true,
                "items": {
                  "time": {
                    "type": "String",
                    "required": true,
                    "comment": "Start time h:m:s"
                  },
                  "zones": "<Array<Integer>,Necessary> Zone water times"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "getVersion",
      "description": "Get firmware info",
      "request": {
        "method": "getVersion",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "version": {
            "type": "String",
            "required": true
          },
          "newVersion": {
            "versionId": {
              "type": "String",
              "required": false
            },
            "versionCode": {
              "type": "String",
              "required": false
            },
            "fileSize": {
              "type": "String",
              "required": false
            }
          }
        }
      }
    },
    {
      "name": "startUpgrade",
      "description": "Start firmware upgrade",
      "request": {
        "method": "startUpgrade",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "versionId": {
            "type": "String",
            "required": true
          }
        }
      },
      "response": {
        "data": {
          "isStarted": {
            "type": "Boolean",
            "required": true
          }
        }
      }
    }
  ],
  "events": [
    {
      "name": "Report",
      "note": "inferred from getState \u2014 not tested against live device",
      "inferred": true,
      "response": {
        "data": {
          "mode": {
            "type": "SprinklerMode",
