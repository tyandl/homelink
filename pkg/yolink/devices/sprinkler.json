            "comment": "['auto','manual','off']"
          },
          "zoneSize": {
            "type": "Integer",
            "required": true,
            "comment": "Number of zones"
          },
          "delay": {
            "type": "Integer",
            "required": true,
            "comment": "Minutes to delay"
          },
          "watering": {
            "zone": {
              "type": "Integer",
              "required": false,
              "comment": "Current watering zone index"
            },
            "total": {
              "type": "Integer",
              "required": false,
              "comment": "Total watering time minutes"
            },
            "left": {
              "type": "Integer",
              "required": false,
              "comment": "Remaining watering time minutes"
            }
          },
          "loraInfo": {
            "type": "LoraInfo",
            "required": false
          }
        }
      }
    },
    {
      "name": "Alert",
      "note": "inferred from getState \u2014 not tested against live device",
      "inferred": true,
      "response": {
        "data": {
          "mode": {
            "type": "SprinklerMode",
            "required": true,
            "comment": "['auto','manual','off']"
          },
          "zoneSize": {
            "type": "Integer",
            "required": true,
            "comment": "Number of zones"
          },
          "delay": {
            "type": "Integer",
            "required": true,
            "comment": "Minutes to delay"
          },
          "watering": {
            "zone": {
              "type": "Integer",
              "required": false,
              "comment": "Current watering zone index"
            },
            "total": {
              "type": "Integer",
              "required": false,
              "comment": "Total watering time minutes"
            },
            "left": {
              "type": "Integer",
              "required": false,
              "comment": "Remaining watering time minutes"
            }
          },
          "loraInfo": {
            "type": "LoraInfo",
            "required": false
