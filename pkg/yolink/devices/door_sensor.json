{
  "name": "DoorSensor",
  "methods": [
    {
      "name": "getState",
      "description": "Get Door Sensor's State",
      "request": {
        "method": "getState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "online": {
            "type": "Boolean",
            "required": true,
            "comment": "Is device online"
          },
          "state": {
            "state": {
              "type": "DoorState",
              "required": true,
              "comment": "['closed','open','error']"
            },
            "battery": {
              "type": "BatteryLevel",
              "required": true,
              "comment": "Battery level 0-4"
            },
            "openRemindDelay": {
              "type": "Integer",
              "required": false,
              "comment": "Open remind delay seconds"
            },
            "alertInterval": {
              "type": "Integer",
              "required": false,
              "comment": "Continuous alert interval"
            },
            "delay": {
              "type": "Integer",
              "required": true,
              "comment": "Delay time"
            },
            "version": {
              "type": "String",
              "required": true,
              "comment": "Firmware version"
            },
            "stateChangedAt": {
              "type": "Timestamp",
              "required": true,
              "comment": "Last state change time"
            }
          },
          "reportAt": {
            "type": "Datetime",
            "required": true,
            "comment": "Report time"
          },
          "deviceId": {
            "type": "String",
            "required": true,
            "comment": "Device ID"
          }
        }
      }
    },
    {
      "name": "getActivityLogs",
      "description": "Retrieve device activity records. Requires DEVICE.HISTORICAL_DATA.READ permission.",
      "request": {
        "method": "getActivityLogs",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "search": {
            "startDate": {
              "type": "String",
              "required": false,
              "comment": "YYYY-MM-DD"
            },
            "endDate": {
              "type": "String",
              "required": false,
              "comment": "YYYY-MM-DD"
            }
          },
          "retrievalKey": {
            "type": "String",
            "required": false,
            "comment": "Retrieval key"
          }
        }
      },
      "response": {
        "data": {
          "logs": {
            "type": "Array",
            "required": true,
            "items": {
              "id": {
                "type": "String",
                "required": true,
                "comment": "Record ID"
              },
              "time": {
                "type": "Date",
                "required": true,
                "comment": "Record time"
              },
              "data": {
                "type": "Object",
                "required": true,
                "comment": "Record data"
              }
            }
          },
          "retrievalKeys": {
            "next": {
              "type": "Object",
              "required": false,
              "comment": "Key for more results"
            }
          }
        }
      }
    },
    {
      "name": "setAttributes",
      "description": "Set device's attributes",
      "request": {
        "method": "setAttributes",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "openRemindDelay": {
            "type": "Integer",
            "required": false,
            "comment": "Open remind seconds 10-64800"
          },
          "alertInterval": {
            "type": "Integer",
            "required": false,
            "comment": "Alert interval minutes 0-120"
          }
        }
      },
      "response": {
        "params": {
          "openRemindDelay": {
            "type": "Integer",
            "required": true
          },
          "alertInterval": {
            "type": "Integer",
            "required": true
          }
        }
      }
    }
  ],
  "events": [
    {
      "name": "Alert",
      "description": "Fired when door state changes or open-remind timeout triggers",
      "response": {
        "data": {
          "state": {
            "type": "DoorState",
            "required": true
          },
          "alertType": {
            "type": "String",
            "required": true,
            "comment": "normal | openRemind"
          },
          "battery": {
            "type": "BatteryLevel",
            "required": true
          },
          "version": {
            "type": "String",
            "required": true
          },
          "loraInfo": {
            "type": "LoraInfo",
            "required": false
          },
          "stateChangedAt": {
            "type": "Timestamp",
            "required": true
          }
        }
      }
    },
    {
      "name": "Report",
      "description": "Periodic door sensor state report",
      "response": {
        "data": {
          "state": {
            "type": "DoorState",
            "required": true
          },
          "alertType": {
            "type": "String",
            "required": true,
            "comment": "normal | openRemind"
          },
          "battery": {
            "type": "BatteryLevel",
            "required": true
          },
          "delay": {
            "type": "Integer",
            "required": true
          },
          "version": {
            "type": "String",
            "required": true
          },
          "openRemindDelay": {
            "type": "Integer",
            "required": false
          },
          "alertInterval": {
            "type": "Integer",
            "required": false
          },
          "loraInfo": {
            "type": "LoraInfo",
            "required": false
          }
        }
      }
    }
  ]
}
