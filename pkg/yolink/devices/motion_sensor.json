{
  "name": "MotionSensor",
  "methods": [
    {
      "name": "getState",
      "description": "Get Motion Sensor's State",
      "request": {
        "method": "getState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "online": {
            "type": "Boolean",
            "required": true,
            "comment": "Is device online"
          },
          "state": {
            "state": {
              "type": "AlarmState",
              "required": true,
              "comment": "['normal','alert']"
            },
            "battery": {
              "type": "BatteryLevel",
              "required": true,
              "comment": "Battery level 0-4"
            },
            "beep": {
              "type": "Boolean",
              "required": true
            },
            "devTemperature": {
              "type": "Integer",
              "required": true
            },
            "sensitivity": {
              "type": "Integer",
              "required": true
            },
            "sensorMode": {
              "type": "String",
              "required": true
            },
            "stateChangedAt": {
              "type": "Timestamp",
              "required": true
            },
            "supportChangeMode": {
              "type": "Boolean",
              "required": true
            },
            "version": {
              "type": "String",
              "required": true
            },
            "alarmState": {
              "stayError": {
                "type": "Boolean"
              },
              "detectorError": {
                "type": "Boolean"
              },
              "freezeError": {
                "type": "Boolean"
              },
              "reminder": {
                "type": "Boolean"
              }
            },
            "alertInterval": {
              "type": "Integer",
              "required": false
            },
            "ledAlarm": {
              "type": "Boolean",
              "required": false
            },
            "batteryType": {
              "type": "String",
              "required": false
            },
            "nomotionDelay": {
              "type": "Integer",
              "required": false
            }
          },
          "reportAt": {
            "type": "Datetime",
            "required": true
          },
          "deviceId": {
            "type": "String",
            "required": true
          }
        }
      }
    },
    {
      "name": "getActivityLogs",
      "description": "Retrieve device activity records. Requires DEVICE.HISTORICAL_DATA.READ permission.",
      "request": {
        "method": "getActivityLogs",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "search": {
            "startDate": {
              "type": "String",
              "required": false,
              "comment": "YYYY-MM-DD"
            },
            "endDate": {
              "type": "String",
              "required": false,
              "comment": "YYYY-MM-DD"
            }
          },
          "retrievalKey": {
            "type": "String",
            "required": false
          }
        }
      },
      "response": {
        "data": {
          "logs": {
            "type": "Array",
            "required": true,
            "items": {
              "id": {
                "type": "String",
                "required": true
              },
              "time": {
                "type": "Date",
                "required": true
              },
              "data": {
                "type": "Object",
                "required": true
              }
            }
          },
          "retrievalKeys": {
            "next": {
              "type": "Object",
              "required": false
            }
          }
        }
      }
    },
    {
      "name": "setAttributes",
      "description": "Set device's attributes",
      "request": {
        "method": "setAttributes",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "alertInterval": {
            "type": "Integer",
            "required": false,
            "comment": "Alert interval minutes"
          },
          "ledAlarm": {
            "type": "Boolean",
            "required": false,
            "comment": "Alarm LED status"
          },
          "nomotionDelay": {
            "type": "Integer",
            "required": false,
            "comment": "Motion delay minutes 0-120"
          },
          "sensitivity": {
            "type": "Integer",
            "required": false,
            "comment": "Sensitivity 1-3"
          }
        }
      },
      "response": {
        "params": {
          "alertInterval": {
            "type": "Integer",
            "required": true
          },
          "ledAlarm": {
            "type": "Boolean",
            "required": true
          },
          "nomotionDelay": {
            "type": "Integer",
            "required": true
          },
          "sensitivity": {
            "type": "Integer",
            "required": true
          }
        }
      }
    }
  ],
  "events": [
    {
      "name": "Alert",
      "description": "Fired when motion is detected or clears",
      "response": {
        "data": {
          "state": {
            "type": "AlertState",
            "required": true,
            "comment": "alert | normal"
          },
          "battery": {
            "type": "BatteryLevel",
            "required": true
          },
          "version": {
            "type": "String",
            "required": true
          },
          "ledAlarm": {
            "type": "Boolean",
            "required": true
          },
          "alertInterval": {
            "type": "Integer",
            "required": true
          },
          "nomotionDelay": {
            "type": "Integer",
            "required": true
          },
          "sensitivity": {
            "type": "Integer",
            "required": true
          },
          "loraInfo": {
            "type": "LoraInfo",
            "required": false
          },
          "stateChangedAt": {
            "type": "Timestamp",
            "required": true
          }
        }
      }
    },
    {
      "name": "Report",
      "description": "Periodic motion sensor state report",
      "response": {
        "data": {
          "state": {
            "type": "AlertState",
            "required": true,
            "comment": "alert | normal"
          },
          "battery": {
            "type": "BatteryLevel",
            "required": true
          },
          "version": {
            "type": "String",
            "required": true
          },
          "ledAlarm": {
            "type": "Boolean",
            "required": true
          },
          "alertInterval": {
            "type": "Integer",
            "required": true
          },
          "nomotionDelay": {
            "type": "Integer",
            "required": true
          },
          "sensitivity": {
            "type": "Integer",
            "required": true
          },
          "devTemperature": {
            "type": "Integer",
            "required": false
          },
          "batteryType": {
            "type": "String",
            "required": false
          },
          "loraInfo": {
            "type": "LoraInfo",
            "required": false
          }
        }
      }
    }
  ]
}
