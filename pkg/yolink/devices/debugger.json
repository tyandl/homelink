{
  "name": "Debugger",
  "description": "Debug tools for raw LoRa device streams",
  "methods": [
    {
      "name": "createAccessToken",
      "description": "Create access token for device debug",
      "request": {
        "method": "createAccessToken",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "scope": {
            "type": "String",
            "required": true,
            "comment": "Fixed: 'device/raw_stream'"
          },
          "expire": {
            "type": "Integer",
            "required": true,
            "comment": "Token validity in seconds"
          }
        }
      },
      "response": {
        "data": {
          "access_token": {
            "access_token": {
              "type": "String",
              "required": true,
              "comment": "Access token"
            }
          },
          "token_type": {
            "type": "String",
            "required": true,
            "comment": "Token type"
          },
          "expires_in": {
            "type": "String",
            "required": true,
            "comment": "Token expiry"
          },
          "scope": {
            "type": "String[]",
            "required": true,
            "comment": "Token scopes"
          }
        }
      }
    },
    {
      "name": "GET /open/yolink/v2/stream/device_raw_event",
      "description": "Get LoRa raw event stream. Requires Bearer token from createAccessToken.",
      "type": "http_get"
    },
    {
      "name": "GET /open/yolink/v2/stream/device_raw_frame",
      "description": "Get LoRa raw frame stream. Requires Bearer token from createAccessToken.",
      "type": "http_get"
    }
  ],
  "dispatch": ""
}
