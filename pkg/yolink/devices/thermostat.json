{
  "name": "Thermostat",
  "methods": [
    {
      "name": "getState",
      "description": "Get Current State",
      "request": {
        "method": "getState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "state": {
            "tempMode": {
              "type": "TemperatureUnit",
              "required": true,
              "comment": "['c','f']"
            },
            "temperature": {
              "type": "Temperature",
              "required": true,
              "comment": "Current temp (Celsius)"
            },
            "humidity": {
              "type": "Float",
              "required": true,
              "comment": "Current humidity %RH"
            },
            "lowTemp": {
              "type": "Temperature",
              "required": true,
              "comment": "Lower setpoint Celsius"
            },
            "highTemp": {
              "type": "Temperature",
              "required": true,
              "comment": "Upper setpoint Celsius"
            },
            "mode": {
              "type": "ThermostatMode",
              "required": true,
              "comment": "['cool','heat','auto','off']"
            },
            "fan": {
              "type": "FanMode",
              "required": true,
              "comment": "['on','auto']"
            },
            "sche": {
              "type": "ThermostatSchedule",
              "required": true,
              "comment": "['run','hold']"
            },
            "running": {
              "type": "ThermostatRunning",
              "required": true,
              "comment": "['cool','heat','idle']"
            },
            "sensor1": {
              "type": "Float",
              "required": false
            },
            "sensor2": {
              "type": "Float",
              "required": false
            },
            "other": {
              "auxiliaryHeat": {
                "type": "Boolean",
                "required": false
              },
              "secondStage": {
                "type": "Boolean",
                "required": false
              },
              "drRunning": {
                "type": "Boolean",
                "required": false
              }
            }
          },
          "properties": {
            "minRuntime": {
              "type": "Object",
              "required": true
            },
            "coolLimit": {
              "type": "Object",
              "required": true
            },
            "heatLimit": {
              "type": "Object",
              "required": true
            },
            "mute": {
              "type": "Boolean",
              "required": false
            },
            "menuLock": {
              "type": "Boolean",
              "required": false
            }
          },
          "eco": {
            "type": "Object",
            "required": true
          },
          "version": {
            "type": "String",
            "required": true
          },
          "tz": {
            "type": "Integer",
            "required": true
          }
        }
      }
    },
    {
      "name": "setState",
      "description": "Set Thermostat's State",
      "request": {
        "method": "setState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "lowTemp": {
            "type": "Temperature",
            "required": false,
            "comment": "Lower setpoint Celsius"
          },
          "highTemp": {
            "type": "Temperature",
            "required": false,
            "comment": "Upper setpoint Celsius"
          },
          "mode": {
            "type": "ThermostatMode",
            "required": false,
            "comment": "['cool','heat','auto','off']"
          },
          "fan": {
            "type": "FanMode",
            "required": false,
            "comment": "['on','auto']"
          },
          "sche": {
            "type": "ThermostatSchedule",
            "required": false,
            "comment": "['run','hold']"
          }
        }
      },
      "response": {
        "data": {
          "state": {
            "type": "String",
            "required": true
          }
        }
      }
    },
    {
      "name": "getSchedules",
      "description": "Get Schedule List",
      "request": {
        "method": "getSchedules",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "sches": {
            "type": "Array",
            "required": true,
            "comment": "Weekday schedules Mon-Sat",
            "items": {
              "time": {
                "type": "String",
                "required": true,
                "comment": "HH:MM"
              },
              "lowTemp": {
                "type": "Temperature",
                "required": true
              },
              "highTemp": {
                "type": "Temperature",
                "required": true
              }
            }
          }
        }
      }
    },
    {
      "name": "setSchedules",
      "description": "Set Schedule (4 points per day, Mon-Sat)",
      "request": {
        "method": "setSchedules",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "sches[weekday]": {
            "type": "Array",
            "required": true,
            "items": {
              "time": {
                "type": "String",
                "required": true,
                "comment": "HH:MM"
              },
              "lowTemp": {
                "type": "Temperature",
                "required": true
              },
              "highTemp": {
                "type": "Temperature",
                "required": true
              }
            }
          }
        }
      },
      "response": {
        "data": {
          "sches": {
            "type": "Array",
            "required": true,
            "comment": "Weekday schedules Mon-Sat",
            "items": {
              "time": {
                "type": "String",
                "required": true,
                "comment": "HH:MM"
              },
              "lowTemp": {
                "type": "Temperature",
                "required": true
              },
              "highTemp": {
                "type": "Temperature",
                "required": true
              }
            }
          }
        }
      }
    },
    {
      "name": "setTimeZone",
      "description": "Set Timezone",
      "request": {
        "method": "setTimeZone",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "tz": {
            "type": "Integer",
            "required": true,
            "comment": "Timezone -12~+12"
          }
        }
      },
      "response": {
        "data": {
          "tz": {
            "type": "Integer",
            "required": true
          }
        }
      }
    },
    {
      "name": "setECO",
      "description": "Set ECO mode settings",
      "request": {
        "method": "setECO",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "mode": {
            "type": "ThermostatSwitch",
            "required": false,
            "comment": "['on','off']"
          },
          "lowTemp": {
            "type": "Temperature",
            "required": false,
            "comment": "ECO lower adjustment 0-5 Celsius"
          },
          "highTemp": {
            "type": "Temperature",
            "required": false,
            "comment": "ECO upper adjustment 0-5 Celsius"
          }
        }
      },
      "response": {
        "data": {
          "eco": {
            "type": "Object",
            "required": true
          }
        }
      }
    },
    {
      "name": "setProperties",
      "description": "Set running properties",
      "request": {
        "method": "setProperties",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "minRuntime": {
            "type": "Integer",
            "required": false
          },
          "coolLimit": {
            "type": "Float",
            "required": false
          },
          "heatLimit": {
            "type": "Float",
            "required": false
          },
          "mute": {
            "type": "Boolean",
            "required": false
          },
          "menuLock": {
            "type": "Boolean",
            "required": false
          },
          "auxStandby": {
            "type": "Integer",
            "required": false
          },
          "auxMaxSpan": {
            "type": "Integer",
            "required": false
          },
          "auxThreshold": {
            "type": "Float",
            "required": false
          },
          "stage2Standby": {
            "type": "Integer",
            "required": false
          },
          "stage2MaxSpan": {
            "type": "Integer",
            "required": false
          },
          "stage2Threshold": {
            "type": "Float",
            "required": false
          },
          "master": {
            "type": "ThermostatMaster",
            "required": false,
            "comment": "['local','sensor1','sensor2']"
          }
        }
      },
      "response": {
        "data": {
          "minRuntime": {
            "type": "Object",
            "required": true
          },
          "coolLimit": {
            "type": "Object",
            "required": true
          },
          "heatLimit": {
            "type": "Object",
            "required": true
          }
        }
      }
    },
    {
      "name": "getVersion",
      "description": "Get firmware info",
      "request": {
        "method": "getVersion",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "version": {
            "type": "String",
            "required": true
          },
          "newVersion": {
            "versionId": {
              "type": "String",
              "required": false
            },
            "versionCode": {
              "type": "String",
              "required": false
            },
            "fileSize": {
              "type": "String",
              "required": false
            }
          }
        }
      }
    },
    {
      "name": "startUpgrade",
      "description": "Start firmware upgrade",
      "request": {
        "method": "startUpgrade",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "versionId": {
            "type": "String",
            "required": true
          }
        }
      },
      "response": {
        "data": {
          "isStarted": {
            "type": "Boolean",
            "required": true
          }
        }
      }
    },
    {
      "name": "getActivityLogs",
      "description": "Retrieve device activity records. Requires DEVICE.HISTORICAL_DATA.READ permission.",
      "request": {
        "method": "getActivityLogs",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "search": {
            "startDate": {
              "type": "String",
              "required": false,
              "comment": "YYYY-MM-DD"
            },
            "endDate": {
              "type": "String",
              "required": false,
              "comment": "YYYY-MM-DD"
            }
          },
          "retrievalKey": {
            "type": "String",
            "required": false
          }
        }
      },
      "response": {
        "data": {
          "logs": {
            "type": "Array",
            "required": true,
            "items": {
              "id": {
                "type": "String",
                "required": true
              },
              "time": {
                "type": "Date",
                "required": true
              },
              "data": {
                "type": "Object",
                "required": true
              }
            }
          },
          "retrievalKeys": {
            "next": {
              "type": "Object",
              "required": false
            }
          }
        }
      }
    },
    {
      "name": "setCorrection",
      "description": "Set temperature and humidity correction of local sensor",
      "request": {
        "method": "setCorrection",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "temperature": {
            "type": "Temperature",
            "required": false,
            "comment": "Correction value +/-5.0 Celsius"
          },
          "humidity": {
            "type": "Float",
            "required": false,
            "comment": "Correction value +/-10 percent"
          }
        }
      },
      "response": {
        "data": {
          "temperature": {
            "type": "Temperature",
            "required": false
          },
          "humidity": {
            "type": "Float",
            "required": false
          }
        }
      }
    }
  ],
