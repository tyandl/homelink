{
  "name": "WaterDepthSensor",
  "methods": [
    {
      "name": "getState",
      "description": "Get the state of Water Depth Sensor. Water depth formula: (range * (waterDepth / 1000)) / density",
      "request": {
        "method": "getState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "state": {
            "online": {
              "type": "Boolean",
              "required": true
            },
            "alarm": {
              "highAlarm": {
                "type": "Boolean",
                "required": true,
                "comment": "Water depth above threshold"
              },
              "lowAlarm": {
                "type": "Boolean",
                "required": true,
                "comment": "Water depth below threshold"
              },
              "detectorError": {
                "type": "Boolean",
                "required": true,
                "comment": "Probe abnormal"
              }
            },
            "alarmSettings": {
              "standby": {
                "type": "Integer",
                "required": true,
                "comment": "Standby seconds [0-7200]"
              },
              "interval": {
                "type": "Integer",
                "required": true,
                "comment": "Alarm interval minutes [10-240]"
              },
              "high": {
                "type": "Integer",
                "required": true,
                "comment": "High threshold [0-1000] per-thousand of range"
              },
              "low": {
                "type": "Integer",
                "required": true,
                "comment": "Low threshold [0-1000] per-thousand of range"
              }
            },
            "battery": {
              "type": "BatteryLevel",
              "required": true,
              "comment": "0-4"
            },
            "waterDepth": {
              "type": "Integer",
              "required": true,
              "comment": "Water depth percentage x10"
            },
            "reportInterval": {
              "type": "Integer",
              "required": true,
              "comment": "Report interval minutes [10-240]"
            },
            "version": {
              "type": "String",
              "required": true
            }
          },
          "reportAt": {
            "type": "Datetime",
            "required": true
          },
          "deviceId": {
            "type": "String",
            "required": true
          }
        }
      }
    },
    {
      "name": "setAttributes",
      "description": "Set attributes for water depth sensor",
      "request": {
        "method": "setAttributes",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "alarmSettings": {
            "standby": {
              "type": "Integer",
              "required": true,
              "comment": "[0-7200] seconds"
            },
            "interval": {
              "type": "Integer",
              "required": true,
              "comment": "[10-240] minutes"
            },
            "high": {
              "type": "Integer",
              "required": true,
              "comment": "[0-1000]"
            },
            "low": {
              "type": "Integer",
              "required": true,
              "comment": "[0-1000]"
            }
          }
        }
      },
      "response": {}
    }
  ],
