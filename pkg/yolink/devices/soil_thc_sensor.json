                "type": "Temperature",
                "required": true,
                "comment": "Current temperature"
              },
              "humidity": {
                "type": "Float",
                "required": true,
                "comment": "Current humidity"
              },
              "conductivity": {
                "type": "Float",
                "required": true,
                "comment": "Current conductivity \u00b5S/cm"
              }
            },
            "attributes": {
