{
  "name": "COSmokeSensor",
  "methods": [
    {
      "name": "getState",
      "description": "Get CO & Smoke Sensor's State",
      "request": {
        "method": "getState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "state": {
            "online": {
              "type": "Boolean",
              "required": true,
              "comment": "Is device online"
            },
            "state": {
              "unexpected": {
                "type": "Boolean",
                "required": true,
                "comment": "Unexpected error detected"
              },
              "sLowBattery": {
                "type": "Boolean",
                "required": true,
                "comment": "Battery of sensor is low"
              },
              "smokeAlarm": {
                "type": "Boolean",
                "required": true,
                "comment": "Smoke detected"
              },
              "gasAlarm": {
                "type": "Boolean",
                "required": true,
                "comment": "CO detected"
              },
              "highTempAlarm": {
                "type": "Boolean",
                "required": true,
                "comment": "High temperature (over 57C) detected"
              },
              "silence": {
                "type": "Boolean",
                "required": true,
                "comment": "Reserve"
              }
            },
            "battery": {
              "type": "BatteryLevel",
              "required": true,
              "comment": "Base battery level 0-4"
            },
            "interval": {
              "type": "Integer",
              "required": false,
              "comment": "Interval of Continuous Alert"
            },
            "metadata": {
              "inspect": {
                "type": "Boolean",
                "required": false,
                "comment": "Self-check result"
              }
            },
            "devTemperature": {
              "type": "Integer",
              "required": true,
              "comment": "Current temperature"
            },
            "sche": {
              "`type`": {
                "type": "ScheduleType",
                "required": true,
                "comment": "Schedule type ['disable','weekly','monthly']"
              },
              "day": {
                "type": "Integer",
                "required": true,
                "comment": "Active day of schedule"
              },
              "time": {
                "type": "String",
                "required": true,
                "comment": "Time of schedule, HH:MM"
              }
            },
            "version": {
              "type": "String",
              "required": true,
              "comment": "Firmware version"
            }
          },
          "reportAt": {
            "type": "Datetime",
            "required": true,
            "comment": "Report time"
          },
          "deviceId": {
            "type": "String",
            "required": true,
            "comment": "Device EUI"
          }
        }
      }
    },
    {
      "name": "setState",
      "description": "Trigger device self-checking",
      "request": {
        "method": "setState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "inspect": {
            "type": "Boolean",
            "required": true,
            "comment": "Start self-checking"
          }
        }
      },
      "response": {}
    },
    {
      "name": "setSchedule",
      "description": "Set the scheduled self-checking",
      "request": {
        "method": "setSchedule",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "`type`": {
            "type": "ScheduleType",
            "required": true,
            "comment": "['disable','weekly','monthly']"
          },
          "day": {
            "type": "Integer",
            "required": true,
            "comment": "Day of schedule"
          },
          "time": {
            "type": "String",
            "required": true,
            "comment": "Time HH:mm"
          }
        }
      },
      "response": {}
    }
  ],
