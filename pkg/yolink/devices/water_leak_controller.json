{
  "name": "WaterLeakController",
  "methods": [
    {
      "name": "getState",
      "description": "Get the state of Water Leak Controller",
      "request": {
        "method": "getState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "state": {
            "valve": {
              "type": "SwitchCommand",
              "required": true,
              "comment": "['close','open']"
            },
            "waterTemp": {
              "type": "Temperature",
              "required": true,
              "comment": "Water temp Celsius"
            },
            "waterFlowingDuration": {
              "type": "Boolean",
              "required": true,
              "comment": "Duration of single water usage"
            }
          },
          "alarm": {
            "leak": {
              "type": "Boolean",
              "required": true
            },
            "noWaterError": {
              "type": "Boolean",
              "required": true,
              "comment": "Dry pipe alarm"
            },
            "freezeError": {
              "type": "Boolean",
              "required": true
            },
            "durationOverrun": {
              "type": "Boolean",
              "required": true
            },
            "reminder": {
              "type": "Boolean",
              "required": true
            },
            "openReminder": {
              "type": "Boolean",
              "required": true
            },
            "sensorDetectorError": {
              "type": "Boolean",
              "required": true
            },
            "valveDetectorError": {
              "type": "Boolean",
              "required": true
            }
          },
          "battery": {
            "type": "BatteryLevel",
            "required": true,
            "comment": "0-4"
          },
          "powerSupply": {
            "type": "PowerSupply",
            "required": true,
            "comment": "['battery','PowerLine']"
          },
          "valveDelay": {
            "on": {
              "type": "Integer",
              "required": false
            },
            "off": {
              "type": "Integer",
              "required": false
            }
          },
          "attributes": {
            "openReminder": {
              "type": "Integer",
              "required": true,
              "comment": "Open remind minutes"
            },
            "alertInterval": {
              "type": "Integer",
              "required": true,
              "comment": "Alert interval minutes"
            },
            "leakPlan": {
              "type": "WaterLeakPlan",
              "required": true,
              "comment": "['Manual','Auto','AwayAuto']"
            },
            "maxOverrunDuration": {
              "type": "Integer",
              "required": true,
              "comment": "Max continuous usage minutes"
            },
            "maxOverrunSensivity": {
              "type": "Integer",
              "required": true
            },
            "maxOverrunCloseValve": {
              "type": "Boolean",
              "required": true
            },
            "awayDuration": {
              "type": "Integer",
              "required": true
            },
            "awayCloseValve": {
              "type": "Boolean",
              "required": true
            },
            "mute": {
              "type": "Boolean",
              "required": true
            },
            "muteDuration": {
              "type": "Integer",
              "required": true
            },
            "waterTemperatureLevel": {
              "type": "WaterTemperatureLevel",
              "required": true,
              "comment": "0=cold,1=hot"
            },
            "freezeACVEnable": {
              "type": "Boolean",
              "required": true
            },
            "leakDetector": {
              "dryPipeTemp": {
                "type": "Temperature",
                "required": true,
                "comment": "Celsius"
              }
            }
          },
          "muteRemaining": {
            "type": "Integer",
            "required": true,
            "comment": "Remaining mute minutes"
          },
          "heaterTemp": {
            "type": "Temperature",
            "required": true
          },
          "waterTemperatureVariance": {
            "type": "Float",
            "required": true
          },
          "version": {
            "type": "String",
            "required": true
          },
          "tz": {
            "type": "Integer",
            "required": true
          }
        }
      }
    },
    {
      "name": "setState",
      "description": "Set valve state",
      "request": {
        "method": "setState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "valve": {
            "type": "SwitchCommand",
            "required": true,
            "comment": "['close','open']"
          }
        }
      },
      "response": {}
    },
    {
      "name": "setAttributes",
      "description": "Set attributes for Water Leak Controller",
      "request": {
        "method": "setAttributes",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "attributes": {
            "openReminder": {
              "type": "Integer",
              "required": false
            },
            "alertInterval": {
              "type": "Integer",
              "required": false
            },
            "leakPlan": {
              "type": "WaterLeakPlan",
              "required": false,
              "comment": "['Manual','Auto','AwayAuto']"
            },
            "maxOverrunDuration": {
              "type": "Integer",
              "required": false
            },
            "maxOverrunSensivity": {
              "type": "Integer",
              "required": false
            },
            "maxOverrunCloseValve": {
              "type": "Boolean",
              "required": false
            },
            "awayDuration": {
              "type": "Integer",
              "required": false
            },
            "awayCloseValve": {
              "type": "Boolean",
              "required": false
            },
            "mute": {
              "type": "Boolean",
              "required": false
            },
            "muteDuration": {
              "type": "Integer",
              "required": false
            },
            "waterTemperatureLevel": {
              "type": "WaterTemperatureLevel",
              "required": false
            },
            "freezeACVEnable": {
              "type": "Boolean",
              "required": false
            },
            "leakDetector": {
              "dryPipeTemp": {
                "type": "Temperature",
                "required": false
              }
            }
          }
        }
      },
      "response": {}
    },
    {
      "name": "getValveSchedules",
      "description": "Get valve schedules",
      "request": {
        "method": "getValveSchedules",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "type": "Array",
          "required": true,
          "items": {
            "isValid": {
              "type": "Boolean",
              "required": true
            },
            "index": {
              "type": "Integer",
              "required": true
            },
            "on": {
              "type": "String",
              "required": false,
              "comment": "HH:mm"
            },
            "off": {
              "type": "String",
              "required": false,
              "comment": "HH:mm"
            },
            "week": {
              "type": "Integer",
              "required": true,
              "comment": "Weekday mask"
            }
          }
        }
      }
    },
    {
      "name": "setValveSchedules",
      "description": "Set valve schedules (index 0-5; isValid=false & week=0 to remove)",
      "request": {
        "method": "setValveSchedules",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "sches": {
            "type": "Array",
            "required": true,
            "items": {
              "isValid": {
                "type": "Boolean",
                "required": true
              },
              "index": {
                "type": "Integer",
                "required": true
              },
              "on": {
                "type": "String",
                "required": true,
                "comment": "HH:mm"
              },
              "off": {
                "type": "String",
                "required": true,
                "comment": "HH:mm"
              },
              "week": {
                "type": "Integer",
                "required": true
              }
            }
          }
        }
      },
      "response": {
        "data": {
          "type": "Array",
          "required": true,
          "items": {
            "isValid": {
              "type": "Boolean",
              "required": true
            },
            "index": {
              "type": "Integer",
              "required": true
            },
            "on": {
              "type": "String",
              "required": false,
              "comment": "HH:mm"
            },
            "off": {
              "type": "String",
              "required": false,
              "comment": "HH:mm"
            },
            "week": {
              "type": "Integer",
              "required": true,
              "comment": "Weekday mask"
            }
          }
        }
      }
    },
