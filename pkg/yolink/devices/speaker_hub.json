{
  "name": "SpeakerHub",
  "methods": [
    {
      "name": "getState",
      "description": "Get SpeakerHub's State",
      "request": {
        "method": "getState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "version": {
            "type": "String",
            "required": true
          },
          "wifi": {
            "enable": {
              "type": "Boolean",
              "required": true
            },
            "ssid": {
              "type": "String",
              "required": true
            },
            "ip": {
              "type": "String",
              "required": true
            },
            "gateway": {
              "type": "String",
              "required": true
            },
            "mask": {
              "type": "String",
              "required": true
            }
          },
          "eth": {
            "enable": {
              "type": "Boolean",
              "required": true
            }
          },
          "options": {
            "volume": {
              "type": "Integer",
              "required": true,
              "comment": "Global volume"
            },
            "enableBeep": {
              "type": "Boolean",
              "required": true,
              "comment": "Beep on actions"
            },
            "mute": {
              "type": "Boolean",
              "required": true,
              "comment": "Mute all sounds"
            }
          }
        }
      }
    },
    {
      "name": "setWiFi",
      "description": "Set device's WiFi info",
      "request": {
        "method": "setWiFi",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "ssid": {
            "type": "String",
            "required": true
          },
          "password": {
            "type": "String",
            "required": true
          }
        }
      },
      "response": {}
    },
    {
      "name": "playAudio",
      "description": "Play audio immediately",
      "request": {
        "method": "playAudio",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "tone": {
            "type": "SpeakerTone",
            "required": false,
            "comment": "['Emergency','Alert','Warn','Tip']"
          },
          "message": {
            "type": "String",
            "required": false,
            "comment": "TTS message to play"
          },
          "volume": {
            "type": "Integer",
            "required": false,
            "comment": "Override volume; uses global if not set"
          },
          "repeat": {
            "type": "Integer",
            "required": false,
            "comment": "Repeat count [0-10]; 0=no repeat"
          }
        }
      },
      "response": {}
    },
    {
      "name": "setOption",
      "description": "Modify device settings",
      "request": {
        "method": "setOption",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        },
        "params": {
          "volume": {
            "type": "Integer",
            "required": false,
            "comment": "Global volume"
          },
          "enableBeep": {
            "type": "Boolean",
            "required": false
          },
          "mute": {
            "type": "Boolean",
            "required": false
          }
        }
      },
      "response": {}
    }
  ],
  "events": [
    {
      "name": "Report",
      "note": "inferred from getState \u2014 not tested against live device",
      "inferred": true,
      "response": {
        "data": {
          "version": {
            "type": "String",
            "required": true
          },
          "wifi": {
            "enable": {
              "type": "Boolean",
              "required": true
            },
            "ssid": {
              "type": "String",
              "required": true
            },
            "ip": {
              "type": "String",
              "required": true
            },
            "gateway": {
              "type": "String",
              "required": true
            },
            "mask": {
              "type": "String",
              "required": true
            }
          },
          "eth": {
            "enable": {
              "type": "Boolean",
              "required": true
            }
          },
          "options": {
            "volume": {
              "type": "Integer",
              "required": true,
              "comment": "Global volume"
            },
            "enableBeep": {
              "type": "Boolean",
              "required": true,
              "comment": "Beep on actions"
            },
            "mute": {
              "type": "Boolean",
              "required": true,
              "comment": "Mute all sounds"
            }
          },
          "loraInfo": {
            "type": "LoraInfo",
            "required": false
          }
        }
      }
    },
    {
      "name": "Alert",
      "note": "inferred from getState \u2014 not tested against live device",
      "inferred": true,
      "response": {
        "data": {
          "version": {
            "type": "String",
            "required": true
          },
          "wifi": {
            "enable": {
              "type": "Boolean",
              "required": true
            },
            "ssid": {
              "type": "String",
              "required": true
            },
            "ip": {
              "type": "String",
              "required": true
            },
            "gateway": {
              "type": "String",
              "required": true
            },
            "mask": {
              "type": "String",
              "required": true
            }
          },
          "eth": {
            "enable": {
              "type": "Boolean",
              "required": true
            }
          },
          "options": {
            "volume": {
              "type": "Integer",
              "required": true,
              "comment": "Global volume"
            },
            "enableBeep": {
              "type": "Boolean",
              "required": true,
              "comment": "Beep on actions"
            },
            "mute": {
              "type": "Boolean",
              "required": true,
              "comment": "Mute all sounds"
            }
          },
          "loraInfo": {
            "type": "LoraInfo",
            "required": false
          },
          "stateChangedAt": {
            "type": "Timestamp",
            "required": false
          }
        }
      }
    }
  ]
}
