{
  "name": "VibrationSensor",
  "methods": [
    {
      "name": "getState",
      "description": "Get Vibration Sensor's State",
      "request": {
        "method": "getState",
        "targetDevice": {
          "type": "String",
          "required": true,
          "comment": "DeviceId"
        },
        "token": {
          "type": "String",
          "required": true,
          "comment": "Net token"
        }
      },
      "response": {
        "data": {
          "state": {
            "online": {
              "type": "Boolean",
              "required": true
            },
            "state": {
              "type": "AlarmState",
              "required": true,
              "comment": "['normal','alert']"
            },
            "battery": {
              "type": "BatteryLevel",
              "required": true,
              "comment": "0-4"
            },
            "alertInterval": {
              "type": "Integer",
              "required": false
            },
            "noVibrationDelay": {
              "type": "Integer",
              "required": false,
              "comment": "Time to enter no-vibration state"
            },
            "version": {
              "type": "String",
              "required": true
            }
          },
          "reportAt": {
            "type": "Datetime",
            "required": true
          },
          "deviceId": {
            "type": "String",
            "required": true
          }
        }
      }
    }
  ],
  "events": [
    {
      "name": "Report",
      "note": "inferred from getState \u2014 not tested against live device",
      "inferred": true,
      "response": {
        "data": {
          "online": {
            "type": "Boolean",
            "required": true
          },
          "state": {
            "type": "AlarmState",
            "required": true,
            "comment": "['normal','alert']"
          },
          "battery": {
            "type": "BatteryLevel",
            "required": true,
            "comment": "0-4"
          },
          "alertInterval": {
            "type": "Integer",
            "required": false
          },
          "noVibrationDelay": {
            "type": "Integer",
            "required": false,
            "comment": "Time to enter no-vibration state"
          },
          "version": {
            "type": "String",
            "required": true
          },
          "loraInfo": {
            "type": "LoraInfo",
            "required": false
          }
        }
      }
    },
    {
      "name": "Alert",
      "note": "inferred from getState \u2014 not tested against live device",
      "inferred": true,
      "response": {
        "data": {
          "online": {
            "type": "Boolean",
            "required": true
          },
          "state": {
            "type": "AlarmState",
            "required": true,
            "comment": "['normal','alert']"
          },
          "battery": {
            "type": "BatteryLevel",
            "required": true,
            "comment": "0-4"
          },
          "alertInterval": {
            "type": "Integer",
            "required": false
          },
          "noVibrationDelay": {
            "type": "Integer",
            "required": false,
            "comment": "Time to enter no-vibration state"
          },
          "version": {
            "type": "String",
            "required": true
          },
          "loraInfo": {
            "type": "LoraInfo",
            "required": false
          },
          "stateChangedAt": {
            "type": "Timestamp",
            "required": false
          }
        }
      }
    }
  ]
}
